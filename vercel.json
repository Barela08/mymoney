{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/admin-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/admin-manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/admin-subdomain-manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/myadmin-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/myadmin-manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/mystaff-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/staff-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/mystaff-manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/staff-manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/[...all]?all=robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api/[...all]?all=sitemap.xml" },
    { "source": "/api/send-reset-email", "destination": "/api/send-reset-email" },
    { "source": "/api/(.*)", "destination": "/api/[...all]?all=$1" },
    {
      "source": "/myadmin-manifest.json",
      "has": [{ "type": "host", "value": "admin.nileshbarela.site" }],
      "destination": "/admin-subdomain-manifest.json"
    },
    {
      "source": "/admin-manifest.json",
      "has": [{ "type": "host", "value": "admin.nileshbarela.site" }],
      "destination": "/admin-subdomain-manifest.json"
    },
    {
      "source": "/((?!api/|assets/|myadmin-|admin-|mystaff-|staff-|sw\\.js|manifest\\.json|logo\\.jpg|icon-|apple-touch-icon|notification-badge|offline\\.html|favicon|icons\\.svg).*)",
      "has": [{ "type": "host", "value": "admin.nileshbarela.site" }],
      "destination": "/myadmin.html"
    },
    { "source": "/mystaff", "destination": "/mystaff.html" },
    { "source": "/mystaff/(.*)", "destination": "/mystaff.html" },
    { "source": "/staff", "destination": "/mystaff.html" },
    { "source": "/staff/(.*)", "destination": "/mystaff.html" },
    { "source": "/myadmin", "destination": "/myadmin.html" },
    { "source": "/myadmin/(.*)", "destination": "/myadmin.html" },
    { "source": "/admin", "destination": "/myadmin.html" },
    { "source": "/admin/(.*)", "destination": "/myadmin.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
